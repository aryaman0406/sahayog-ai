# Sahayog AI - Frontend Environment Configuration

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# When set, the official Google Identity Services one-tap and button will use this Client ID.
# Leave empty for instant local development demo account picker.
VITE_GOOGLE_CLIENT_ID=

# Backend API URL (optional in dev, defaults to empty string which proxies through Vite)
VITE_API_URL=
